        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "direction": {
            "type": "string",
            "enum": [
              "outbound",
              "return"
            ]
          },
          "originZoneId": {
            "type": "string",
            "minLength": 1
          },
          "departureTime": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
          },
          "daysOfWeek": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "minItems": 1
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "seatsTotal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "maxDetourMinutes": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  0
                ]
              },
              {
                "type": "number",
                "enum": [
                  5
                ]
              },
              {
                "type": "number",
                "enum": [
                  10
                ]
              }
            ]
          },
          "womenOnly": {
            "type": "boolean",
            "default": false
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 280
          }
