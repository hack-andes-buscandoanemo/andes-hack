{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "vitest run --passWithNoTests",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@andes-hack/api": "workspace:*",
    "@andes-hack/auth": "workspace:*",
    "@andes-hack/db": "workspace:*",
    "@andes-hack/env": "workspace:*",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@hono/zod-openapi": "^1.6.3",
    "@react-email/components": "^1.0.12",
    "@scalar/hono-api-reference": "^0.11.16",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.3",
    "evlog": "^2.30.0",
    "hono": "catalog:",
    "react": "catalog:",
    "react-email": "^6.11.0",
    "resend": "^6.32.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@andes-hack/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  }
