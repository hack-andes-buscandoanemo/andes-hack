{
  "openapi": "3.1.0",
  "info": {
    "title": "andes-hack API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://andes-hack-server-diego.diegorafaelcisnerostafur.workers.dev",
      "description": "Production server"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Comunidades",
      "description": "Acceso y gestión de comunidades e instituciones aliadas"
    },
    {
      "name": "Ofertas",
      "description": "Publicación y gestión de recorridos ofrecidos por conductores"
    },
    {
      "name": "Búsqueda",
      "description": "Búsqueda de viajes compatibles para pasajeros"
    },
    {
      "name": "Solicitudes",
      "description": "Solicitudes de asiento y confirmación de pasajeros"
    },
    {
      "name": "Emparejamiento",
      "description": "Compatibilidad de rutas, horarios y gasto compartido"
    },
    {
      "name": "Público",
      "description": "Rutas públicas y estado del servicio"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["status"]
      },
      "CommunitiesResponse": {
        "type": "object",
        "properties": {
          "communities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommunitySummary"
            }
          }
        },
        "required": ["communities"]
      },
      "CommunitySummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["company", "university", "public_entity", "event"]
          },
          "isDemo": {
            "type": "boolean"
          },
          "hasEmailVerification": {
            "type": "boolean"
          },
          "matchedEmailDomain": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "name", "kind", "isDemo", "hasEmailVerification", "matchedEmailDomain"]
      },
      "JoinCommunityResponse": {
        "type": "object",
        "properties": {
          "joined": {
            "type": "boolean",
            "enum": [true]
          },
          "alreadyMember": {
            "type": "boolean"
          },
          "communityId": {
            "type": "string",
            "format": "uuid"
          },
          "communityName": {
            "type": "string"
          },
          "verificationMethod": {
            "type": "string",
            "enum": ["join_code", "email_domain"]
          },
          "isTeam": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "joined",
          "alreadyMember",
          "communityId",
          "communityName",
          "verificationMethod",
          "isTeam",
          "message"
        ]
      },
      "JoinCommunityRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["code"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Público"],
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/communities": {
      "get": {
        "tags": ["Comunidades"],
        "responses": {
          "200": {
            "description": "Lista pública de comunidades",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunitiesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/communities/{id}/join": {
      "post": {
        "tags": ["Comunidades"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinCommunityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Membresía verificada en la comunidad",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinCommunityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/communities/{id}/verify-email": {
      "post": {
        "tags": ["Comunidades"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Membresía verificada con correo institucional",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinCommunityResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
