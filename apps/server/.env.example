BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Resend API key - get it at https://resend.com
RESEND_API_KEY=
# Email address to send from (must be verified in Resend)
RESEND_FROM_EMAIL=
CORS_ORIGIN=http://localhost:3001
# Log level - trace, debug, info, warn, error, or fatal
LOG_LEVEL=info
# Upstash Redis REST URL - get it at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token - get it at https://console.upstash.com
UPSTASH_REDIS_REST_TOKEN=
# Upstash Redis protocol URL for Go, Rust, and Java clients
UPSTASH_REDIS_URL=
# Cloudflare account ID - get it at https://dash.cloudflare.com
R2_ACCOUNT_ID=
# R2 access key ID - generate at Cloudflare R2 > Manage R2 API Tokens
R2_ACCESS_KEY_ID=
# R2 secret access key
R2_SECRET_ACCESS_KEY=
# R2 bucket name for file storage
R2_BUCKET_NAME=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydb?schema=public
# Comma-separated list of team member emails to mark with is_team = true
TEAM_EMAILS=
# Demo community join code (bun db:seed), 8 characters or more; only its hash is stored
DEMO_JOIN_CODE=
# Team account that bun db:seed makes admin of the demo community; sign up in the app first
DEMO_ADMIN_EMAIL=
# Comma-separated list of team member emails to mark with is_team = true
TEAM_EMAILS=
