    "apps/server/package.json": "{\n  \"name\": \"server\",\n  \"main\": \"src/index.ts\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsdown\",\n    \"check-types\": \"tsc -b\",\n    \"compile\": \"bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server\",\n    \"test\": \"vitest run --passWithNoTests\",\n    \"dev\": \"bun run --hot src/index.ts\",\n    \"start\": \"bun run dist/index.mjs\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@andes-hack/env\": \"workspace:*\",\n    \"@andes-hack/api\": \"workspace:*\",\n    \"@andes-hack/auth\": \"workspace:*\",\n    \"hono\": \"catalog:\",\n    \"@hono/zod-openapi\": \"^1.6.3\",\n    \"@scalar/hono-api-reference\": \"^0.11.16\",\n    \"better-auth\": \"catalog:\",\n    \"resend\": \"^6.32.0\",\n    \"@react-email/components\": \"^1.0.12\",\n    \"react-email\": \"^6.11.0\",\n    \"react\": \"catalog:\",\n    \"evlog\": \"^2.30.0\",\n    \"@upstash/ratelimit\": \"^2.2.0\",\n    \"@upstash/redis\": \"^1.39.0\",\n    \"@aws-sdk/client-s3\": \"^3.1146.0\",\n    \"@aws-sdk/s3-request-presigner\": \"^3.1146.0\",\n    \"@andes-hack/db\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^6.0.3\",\n    \"tsdown\": \"^0.22.3\",\n    \"@andes-hack/config\": \"workspace:*\",\n    \"@types/bun\": \"catalog:\",\n    \"@types/react\": \"catalog:\",\n    \"vitest\": \"catalog:\",\n    \"@vitest/ui\": \"catalog:\",\n    \"@vitest/coverage-v8\": \"catalog:\",\n    \"jsdom\": \"catalog:\"\n  }\n}\n",
