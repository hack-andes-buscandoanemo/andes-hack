                ]
              },
              "website": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "onSiteCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "wantsPilot": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "institution",
              "email",
              "consent",
              "role",
              "onSiteCount",
              "wantsPilot"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "individual"
                ]
              },
              "institution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "email": {
                "type": "string",
                "maxLength": 254,
                "format": "email"
              },
              "consent": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "website": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "institution",
              "email",
              "consent"
            ]
          }
        ]
      },
